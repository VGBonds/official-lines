# Copy this file to .env and fill in the values. Never commit .env.

# Anthropic API key (console.anthropic.com -> API keys). Pay-as-you-go, not a Claude subscription.
ANTHROPIC_API_KEY=

# Hard monthly cap on LLM spend, in US dollars. Official Lines stops calling the LLM once reached.
OFFICIAL_LINES_MONTHLY_BUDGET_USD=40

# Public address of the site (used in links and the weekly brief). No trailing slash.
OFFICIAL_LINES_SITE_URL=http://localhost:8000

# Where the database and the generated site live. Defaults are fine for local use.
# OFFICIAL_LINES_DATA_DIR=data
# OFFICIAL_LINES_SITE_DIR=site

# Models. Defaults: cheap model for per-statement extraction and grouping, stronger one for analysis.
# OFFICIAL_LINES_EXTRACT_MODEL=claude-haiku-5-5
# OFFICIAL_LINES_ANALYZE_MODEL=claude-sonnet-5-5

# Daily caps that keep cost predictable.
# OFFICIAL_LINES_MAX_EXTRACT_PER_RUN=300
# OFFICIAL_LINES_MAX_ANALYSES_PER_DAY=12
# OFFICIAL_LINES_MAX_NEW_ITEMS_PER_SOURCE=15
