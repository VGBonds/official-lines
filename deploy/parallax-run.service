[Unit]
Description=Parallax pipeline: collect, extract, group, analyze, build site
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=parallax
WorkingDirectory=/home/parallax/parallax
ExecStart=/home/parallax/.local/bin/uv run --frozen parallax run
TimeoutStartSec=2h
Nice=10
